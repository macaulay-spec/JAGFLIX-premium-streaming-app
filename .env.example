# Server only. Never prefix with NEXT_PUBLIC and never expose in browser code.
ZST_API_KEY=

# Browser-safe Supabase public values from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional GitHub Actions / Supabase CLI deployment secrets.
# Configure these in GitHub repository secrets, not in this file:
# SUPABASE_ACCESS_TOKEN
# SUPABASE_PROJECT_ID
# SUPABASE_DB_PASSWORD
